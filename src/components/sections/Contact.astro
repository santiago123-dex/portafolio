---
import ContactScene from '@/components/three/ContactScene';
---

<section id="contact" class="relative min-h-screen flex items-center justify-center overflow-hidden px-6 py-24">
  <div class="absolute inset-0 z-0">
    <ContactScene client:visible />
  </div>

  <div class="absolute inset-0 bg-gradient-to-t from-bg via-bg/50 to-transparent z-[1] pointer-events-none" />

  <div class="relative z-10 max-w-3xl mx-auto w-full text-center section-reveal">
    <div class="reveal-child space-y-6">
      <p class="text-sm font-mono text-primary tracking-[0.2em] uppercase">Contacto</p>
      <h2 class="text-4xl md:text-5xl font-bold leading-tight">
        Hablemos de tu <span class="gradient-text">próximo proyecto</span>
      </h2>
      <p class="text-muted text-lg max-w-xl mx-auto text-balance">
        Estoy abierto a nuevas oportunidades y colaboraciones.
        Si tenés un proyecto en mente, mandame un mensaje.
      </p>
      <div class="flex flex-col items-center gap-4 pt-4">
        <a
          href="mailto:hola@ejemplo.com"
          class="inline-flex items-center gap-3 px-8 py-4 bg-primary/10 border border-primary/30 text-primary font-medium rounded-full hover:bg-primary/20 hover:border-primary transition-all group"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="group-hover:scale-110 transition-transform">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
          santiagofajardomorales17@gmail.com
        </a>
        <p class="text-xs text-muted mt-2">
          Respondo en menos de 24 horas
        </p>
      </div>
    </div>
  </div>
</section>
