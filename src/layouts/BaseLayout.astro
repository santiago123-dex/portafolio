---
import '@/styles/globals.css';
import Header from '@/components/ui/Header.astro';
import ScrollProgress from '@/components/ui/ScrollProgress.astro';
import Footer from '@/components/ui/Footer.astro';
import SiteInitializer from '@/components/animations/SiteInitializer';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="Portfolio personal - Proyectos y sobre mí" />
  </head>
  <body>
    <ScrollProgress />
    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />
    <SiteInitializer client:load />
  </body>
</html>
